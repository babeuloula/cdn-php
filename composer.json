{
    "name": "babeuloula/cdn-php",
    "description": "A CDN written in PHP",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-imagick": "*",
        "babeuloula/phpunit-coverage-checker": "^1.0",
        "bref/bref": "^3.0.14",
        "bref/extra-php-extensions": "^3.0",
        "bref/logger": "^3.0",
        "league/flysystem": "^3.36",
        "league/flysystem-aws-s3-v3": "^3.35",
        "league/glide": "^4.2",
        "matthiasmullie/minify": "^1.3",
        "symfony/dotenv": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/string": "^8.1",
        "symfony/translation-contracts": "^3.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/flysystem-memory": "^3.31",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/var-dumper": "^8.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BaBeuloula\\CdnPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BaBeuloula\\CdnPhp\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "BaBeuloula",
            "email": "info@babeuloula.fr"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        }
    }
}
